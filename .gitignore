# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Large raw & binary data files
data*/raw/
data*/cleaned/
data*/processed/
data*/reports/
data*/shards/
data*/*.jsonl
*.bin
*.jsonl
*.db
*.sqlite3
*.arrow
*.parquet
*.zst

# Local knowledge bases (raw binary db)
knowledge_base/*.db
knowledge_base/*.sqlite3

# Large model checkpoint binaries (>100MB)
checkpoints/*.pt
experiments/**/*.pt
experiments/**/checkpoints/
*.zip
*.tar
*.tar.gz
*.7z

# Tokenizer artifacts (trained, potentially large)
tokenizer/*.model

# Logs
*.log
logs/
experiments/**/logs/
experiments/**/*.log

# OS
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Explicit Inclusions: Keep essential manifests, metadata, tokenizer & configs
# -----------------------------------------------------------------------------
!DATASET_CHECKSUMS_SHA256.json
!DATASET_CHECKSUMS.md
!data*/manifest.json
!experiments/**/config.yaml
!experiments/**/metrics.jsonl
!experiments/*.json
!tokenizer/tokenizer.json
!tokenizer/tokenizer_config.json
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/processed/train/.gitkeep
!data/processed/validation/.gitkeep
!data/reports/.gitkeep
!checkpoints/.gitkeep
!logs/.gitkeep
!experiments/.gitkeep
!tokenizer/.gitkeep
